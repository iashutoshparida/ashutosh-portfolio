---
// Approved static figure: WebP with PNG fallback, explicit size, lazy below the fold.
import EvidenceStamp from '../EvidenceStamp.astro';
import { href } from '../../lib/data';
import type { EvidenceId } from '../../lib/schemas';
interface Props {
  src: string; // path without extension, under /figures
  width: number;
  height: number;
  alt: string;
  caption: string;
  maxWidth?: number;
  evidenceId?: EvidenceId;
}
const { src, width, height, alt, caption, evidenceId, maxWidth } = Astro.props;
---

<figure class="fig" style={maxWidth ? `max-width:${maxWidth}px` : undefined}>
  <picture>
    <source srcset={href(`/figures/${src}.webp`)} type="image/webp" />
    <img src={href(`/figures/${src}.png`)} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  </picture>
  <figcaption class="t-small graphite">
    {evidenceId && <EvidenceStamp evidenceId={evidenceId} />}
    {caption}
  </figcaption>
</figure>

<style>
  .fig {
    margin-block: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  .fig img {
    width: 100%;
    height: auto;
    border: var(--rule-soft);
    background: #fff;
  }
  .fig figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
  }
</style>
