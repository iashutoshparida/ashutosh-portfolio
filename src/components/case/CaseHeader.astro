---
import EvidenceStamp from '../EvidenceStamp.astro';
import { lensLabel, type ProjectEntry } from '../../lib/data';
interface Props {
  project: ProjectEntry;
}
const p = Astro.props.project.data;
const kicker = p.tier === 'flagship' ? `Report ${p.number}` : 'Brief';
---

<header class="case-head">
  <div class="case-head__kicker">
    <span class="t-label">{kicker}</span>
    <span class="t-label graphite">{p.lenses.map(lensLabel).join(' · ')}</span>
    {p.primary_evidence && <EvidenceStamp evidenceId={p.primary_evidence} />}
  </div>
  <h1 class:list={['case-head__title', p.tier === 'flagship' ? 'is-report' : 'is-brief']} style={`view-transition-name: title-${p.slug}`}>
    {p.title}
  </h1>
  {p.subtitle && <p class="case-head__sub t-label graphite">{p.subtitle}</p>}
  <p class="case-head__q t-statement">{p.question}</p>
</header>

<style>
  .case-head {
    padding-block: var(--space-8) var(--space-7);
    display: grid;
    gap: var(--space-4);
  }
  .case-head__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  .case-head__title {
    font-family: var(--font-sans);
    font-stretch: 62%;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.86;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .case-head__title.is-report {
    font-size: clamp(56px, 10.5vw, 168px);
  }
  .case-head__title.is-brief {
    font-size: var(--fs-h1);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.95;
  }
  .case-head__q {
    max-width: 22ch;
  }
  .is-brief ~ .case-head__q {
    font-size: clamp(22px, 2.4vw, 34px);
    max-width: 32ch;
  }
</style>
