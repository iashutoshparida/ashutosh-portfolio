---
// I-6: sticky rail (lg), jump menu (sm). Built only from the H2s present.
import type { Section } from '../lib/data';
interface Props {
  sections: Section[];
}
const { sections } = Astro.props;
---

<nav class="rail" aria-label="Sections" data-rail>
  <ol class="rail__list">
    {
      sections.map((s, i) => (
        <li>
          <a class="t-label" href={`#${s.id}`} data-rail-link={s.id}>
            §{i + 1} {s.title}
          </a>
        </li>
      ))
    }
  </ol>
  <label class="rail__jump">
    <span class="visually-hidden">Jump to section</span>
    <select class="t-label" data-rail-select>
      {sections.map((s, i) => <option value={s.id}>§ {i + 1} {s.title} ▾</option>)}
    </select>
  </label>
</nav>

<script src="../scripts/rail.ts"></script>

<style>
  .rail {
    position: sticky;
    top: var(--space-6);
    align-self: start;
  }
  .rail__list {
    display: grid;
    gap: var(--space-1);
  }
  .rail__list a {
    display: flex;
    align-items: center;
    min-height: 32px;
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
  }
  .rail__list a[aria-current='true'] {
    color: var(--signal);
    border-left-color: var(--signal);
  }
  .rail__list a:hover {
    color: var(--signal);
  }
  .rail__jump {
    display: none;
  }
  @media (max-width: 1199px) {
    .rail {
      top: 0;
      z-index: 20;
      background: var(--paper);
      border-bottom: var(--rule);
      padding-block: var(--space-2);
    }
    .rail__list {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: var(--space-4);
    }
    .rail__list a {
      white-space: nowrap;
      border-left: 0;
      border-bottom: 2px solid transparent;
      padding-left: 0;
      min-height: 44px;
    }
    .rail__list a[aria-current='true'] {
      border-bottom-color: var(--signal);
    }
  }
  @media (max-width: 767px) {
    .rail {
      top: 56px;
    }
    .rail__list {
      display: none;
    }
    .rail__jump {
      display: block;
    }
    .rail__jump select {
      width: 100%;
      min-height: 44px;
      border: var(--rule);
      border-radius: 0;
      background: var(--paper);
      padding: 0 var(--space-3);
      appearance: none;
    }
  }
</style>
