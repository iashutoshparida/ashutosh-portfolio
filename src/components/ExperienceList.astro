---
import EvidenceStamp from './EvidenceStamp.astro';
import { about } from '../lib/data';
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<ul class="exp">
  {
    about.experience.map((e) => (
      <li class="exp__row">
        <span class="t-label">{e.dates}</span>
        <span class="exp__role">
          {e.pending ? (
            <>
              {e.role.replace(/\s*\[[^\]]+\]\s*$/, '')} <span class="pending">{(e.role.match(/\[[^\]]+\]/) ?? ['[PENDING]'])[0]}</span>
            </>
          ) : (
            e.role
          )}
        </span>
        <span>{e.org}</span>
        {detailed && e.points && (
          <div class="exp__points">
            <ul>
              {e.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
            {e.evidence && <EvidenceStamp evidenceId={e.evidence} />}
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  .exp__row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: var(--rule-soft);
    font-size: 18px;
  }
  .exp__row:first-child {
    border-top: var(--rule);
  }
  .exp__role {
    font-weight: 600;
  }
  .exp__points {
    grid-column: 2 / -1;
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    font-size: 16px;
    max-width: 78ch;
  }
  .exp__points ul {
    display: grid;
    gap: var(--space-2);
  }
  .exp__points li {
    padding-left: 1.2em;
    text-indent: -1.2em;
  }
  .exp__points li::before {
    content: '— ';
    color: var(--graphite);
  }
  @media (max-width: 767px) {
    .exp__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .exp__points {
      grid-column: 1;
      margin-top: var(--space-2);
    }
  }
</style>
