---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/grid.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, href } from '../lib/data';
import archivoUrl from '../assets/fonts/archivo-var-latin.woff2?url';
import plex500Url from '../assets/fonts/ibm-plex-mono-500-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  current?: 'work' | 'lab' | 'about' | null;
  og?: string;
  footerContact?: boolean;
}
const { title, description, current = null, og = 'default', footerContact = true } = Astro.props;
const fullTitle = title === site.name ? `${site.name}: ${site.statement.join(' ')}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(href(`/og/${og}.png`), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F3F1EC" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap.xml')} />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex500Url} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter withContact={footerContact} />
    <script src="../scripts/global.ts"></script>
  </body>
</html>
